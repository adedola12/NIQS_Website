PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/niqs?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
CLIENT_URL=http://localhost:5173

# ── DNS ──────────────────────────────────────────────────────────────────────
# Unset  → public resolvers (8.8.8.8, 1.1.1.1), which work around flaky ISP DNS
#          failing to resolve Atlas SRV records on a developer machine.
# system → use the OS/VPC resolver. Required on ECS; a task in a private subnet
#          cannot reach 8.8.8.8 and Mongo resolution fails outright.
# DNS_SERVERS=system

# ── File storage (see utils/storage.js) ─────────────────────────────────────
# Images < 10 MB go to Cloudinary; PDFs and anything >= 10 MB go to S3.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# S3 tier. No access keys here by design — the SDK resolves the ECS task role in
# production and your local AWS profile in development. Provision with
# infra/cloudformation/01-foundation.yml and read the stack outputs.
# S3_BUCKET=niqs-assets-<account-id>-<region>
# AWS_REGION=eu-west-1
# ASSET_CDN_URL=https://<distribution>.cloudfront.net

# ── Graceful shutdown (ECS allows 30s between SIGTERM and SIGKILL) ──────────
# PRE_DRAIN_MS=5000
# DRAIN_TIMEOUT_MS=10000

# ── Email ───────────────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ADMIN_EMAIL=

# ── Membership portal integration (docs/PORTAL_INTEGRATION_SPEC.md) ─────────
# Powers the registered-QS directory and member verification at /api/qs/*, and
# lets the QS firm directory defer to the portal if it ends up owning firms.
# Unset, every one of those routes answers 200 with configured:false and the
# website says the register is not connected yet — nothing errors.
#
# Not live as at July 2026: portal.niqsng.org serves the member-portal SPA, not
# this REST API. The NIQS public statistics key does NOT grant member records.
# PORTAL_API_URL=https://portal.niqsng.org/api/v1
# PORTAL_API_KEY=
# PORTAL_TIMEOUT_MS=10000

# ── Public membership statistics (docs/PUBLIC_STATS_API.md) ─────────────────
# Aggregate counts for the public site, from NIQS/API/PUBLIC-001. Unset, the
# /api/stats/membership route answers 503 and the website falls back to its
# static copy — nothing breaks, the figures are just not live.
#
# The key is issued per consumer by the NIQS secretariat and is individually
# revocable. Put the real value in the deployment's environment variables (ECS
# task definition / local .env), never in a committed file. Report a suspected
# exposure to the NIQS technical contact and a replacement is issued same-day.
# NIQS_STATS_API_KEY=niqs_pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NIQS_STATS_API_URL=https://api.niqsng.org/api/public/stats
# NIQS_STATS_TIMEOUT_MS=10000
# NIQS_STATS_CACHE_MS=1800000      # match the upstream 30-minute server cache
# NIQS_STATS_STALE_MS=86400000     # serve last-known figures for up to a day
