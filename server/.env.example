PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/niqs?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
CLIENT_URL=http://localhost:5173

# ── DNS ──────────────────────────────────────────────────────────────────────
# Unset  → public resolvers (8.8.8.8, 1.1.1.1), which work around flaky ISP DNS
#          failing to resolve Atlas SRV records on a developer machine.
# system → use the OS/VPC resolver. Required on ECS; a task in a private subnet
#          cannot reach 8.8.8.8 and Mongo resolution fails outright.
# DNS_SERVERS=system

# ── File storage (see utils/storage.js) ─────────────────────────────────────
# Images < 10 MB go to Cloudinary; PDFs and anything >= 10 MB go to S3.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# S3 tier. No access keys here by design — the SDK resolves the ECS task role in
# production and your local AWS profile in development. Provision with
# infra/cloudformation/01-foundation.yml and read the stack outputs.
# S3_BUCKET=niqs-assets-<account-id>-<region>
# AWS_REGION=eu-west-1
# ASSET_CDN_URL=https://<distribution>.cloudfront.net

# ── Graceful shutdown (ECS allows 30s between SIGTERM and SIGKILL) ──────────
# PRE_DRAIN_MS=5000
# DRAIN_TIMEOUT_MS=10000

# ── Email ───────────────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ADMIN_EMAIL=

# ── Membership portal integration (docs/PORTAL_INTEGRATION_SPEC.md) ─────────
# PORTAL_API_URL=
# PORTAL_API_KEY=
# PORTAL_TIMEOUT_MS=10000
