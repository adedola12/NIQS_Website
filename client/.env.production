# Points at the ECS Express Mode service in eu-west-3 (Paris), co-located with
# the MongoDB Atlas cluster. Replaced https://niqs-website.onrender.com/api on
# 2026-07-30 after Render suspended the service at the account level.
#
# This is the AWS-generated hostname. Mapping api.niqsng.org onto the managed ALB
# would decouple this file from the infrastructure — worth doing before the
# hostname spreads anywhere permanent. See infra/README.md.
VITE_API_URL=https://ni-1f3bf703b9454759bba61dc4f166eb0f.ecs.eu-west-3.on.aws/api

# ── Web analytics ────────────────────────────────────────────────────────────
# Which provider is live. 'ga4' | 'plausible' | 'none'. With this unset, whichever
# one below has credentials is used; with no credentials at all the analytics code
# is inert and no third-party request is made — which is what happens in local
# development, and is deliberate.
VITE_ANALYTICS_PROVIDER=ga4

# The "NIQS Website" property, under the "Nigerian Institute of Quantity Surveyors"
# account — deliberately its own account rather than a property under ADLM's, so
# that access can be handed to the Institute without moving anything. GA4 data
# cannot be migrated between properties, so this was worth getting right on the
# first day rather than the second.
#
# Not a secret: it ships in the JavaScript bundle and is readable by anyone who
# views source. It names the property; it grants no access to it.
VITE_GA4_ID=G-B12YFDYNZJ

# Plausible is wired but idle — cookieless, and the day it is switched on the
# cookie notice disappears with the cookies. To move: set VITE_ANALYTICS_PROVIDER
# to 'plausible' and put the domain here (the site name registered with
# Plausible, e.g. niqs.org.ng).
VITE_PLAUSIBLE_DOMAIN=
